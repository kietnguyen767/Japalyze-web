generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  name               String?
  password           String?
  avatar             String?
  role               String               @default("user")
  isPremium          Boolean              @default(false)
  analysisUsage   Int      @default(0)
  provider           String               @default("email")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  comments           Comment[]
  decks              Deck[]
  exerciseProgress   ExerciseProgress[]
  likes              Like[]
  payments           Payment[]
  posts              Post[]
  translationHistory TranslationHistory[]
}

model Payment {
  id        String   @id @default(uuid())
  orderCode Int      @unique
  amount    Int
  status    String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deck {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  userId      String
  cards       Card[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id        String   @id @default(uuid())
  front     String
  back      String
  example   String?
  isLearned Boolean  @default(false)
  createdAt DateTime @default(now())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model TranslationHistory {
  id         String   @id @default(uuid())
  sourceText String
  targetText String
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DictionaryRelation {
  id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  fromId    String
  toId      String
  type      String          @default("related")
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  from      DictionaryEntry @relation("DictRelFrom", fields: [fromId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  to        DictionaryEntry @relation("DictRelTo", fields: [toId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([fromId, toId, type])
  @@index([fromId], map: "dictrel_fromid_idx")
  @@index([toId], map: "dictrel_toid_idx")
}

model DictionaryEntry {
  id          String               @id @default(uuid())
  lang        String               @default("ja")
  lemma       String
  reading     String?
  romaji      String?
  posTag      String
  meaningVi   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  relatedFrom DictionaryRelation[] @relation("DictRelFrom")
  relatedTo   DictionaryRelation[] @relation("DictRelTo")
  examples    ExampleSentence[]

  @@index([lang])
  @@index([lemma])
  @@index([reading])
  @@index([romaji])
  @@index([posTag])
  @@index([lemma(ops: raw("gin_trgm_ops"))], map: "dictionary_lemma_trgm", type: Gin)
  @@index([reading(ops: raw("gin_trgm_ops"))], map: "dictionary_reading_trgm", type: Gin)
  @@index([romaji(ops: raw("gin_trgm_ops"))], map: "dictionary_romaji_trgm", type: Gin)
}

model ExampleSentence {
  id        String          @id @default(uuid())
  jp        String
  romaji    String?
  vi        String?
  createdAt DateTime        @default(now())
  entryId   String
  entry     DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model ExerciseProgress {
  id          String   @id @default(uuid())
  exerciseId  String
  score       Int
  completedAt DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        String    @id @default(uuid())
  content   String
  rating    Int       @default(5)
  createdAt DateTime  @default(now())
  userId    String
  comments  Comment[]
  likes     Like[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}
// Bảng lưu thông tin lá bài (Dữ liệu tĩnh)
model TarotCard {
  id             String   @id // VD: "major-0"
  name           String   // Tên tiếng Anh
  nameVi         String   // Tên tiếng Việt
  image          String   // Đường dẫn ảnh local: "/images/tarot/major-0.jpg"
  keywords       String[] // Từ khóa
  meaningUpright String   // Ý nghĩa xuôi (AI sẽ đọc cái này)
  
  // Các trường phụ
  meaningReversed String?  
  element         String?  
}

model ReadingArticle {
  id             String   @id @default(uuid())
  title          String
  excerpt        String?
  content        String   // Nội dung Nhật (có format Kanji[furi])
  contentRomaji  String?  // <--- THÊM MỚI: Nội dung Romaji
  contentMeaning String?  // <--- THÊM MỚI: Dịch nghĩa tiếng Việt
  level          String
  topic          String?
  image          String?
  createdAt      DateTime @default(now())
}